# Auth — points to the deployed collectory-api
VITE_APP_API_URL=https://collections.ala.org.au
VITE_APP_BASE_URL=https://collections.ala.org.au

# Collectory API
VITE_API_BASE_URL=https://collectory-ws.ala.org.au

# ALA Common UI fragments
VITE_COMMON_HEADER_HTML=https://static.ala.org.au/common/header.html
VITE_COMMON_FOOTER_HTML=https://static.ala.org.au/common/footer.html
VITE_COMMON_CSS=https://static.ala.org.au/common/common.css
