# Backend API base URL (points to the collectory-api WS subdomain for this env)
VITE_API_BASE_URL=https://collectory-ws.ala.org.au

# OIDC — injected at build time by npm_build_buildspec.yaml
VITE_OIDC_AUTHORITY=https://auth.ala.org.au/cas/oidc/.well-known
VITE_OIDC_CLIENT_ID=ENTER-HERE
VITE_OIDC_REDIRECT_URI=ENTER-HERE
VITE_OIDC_SCOPE=openid profile ala roles

# ALA Common UI fragments
VITE_COMMON_HEADER_HTML=https://static.ala.org.au/common/header.html
VITE_COMMON_FOOTER_HTML=https://static.ala.org.au/common/footer.html
VITE_COMMON_CSS=https://static.ala.org.au/common/common.css
VITE_COMMON_JS=https://static.ala.org.au/common/common.js
VITE_BANNER_MESSAGES_URL=https://static.ala.org.au/common/status.json
VITE_BANNER_SCOPE=collectory
