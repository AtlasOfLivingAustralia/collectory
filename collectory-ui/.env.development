# Backend API proxy (Vite dev server proxies /ws to this)
VITE_API_BASE_URL=http://localhost:8080

# OIDC - these are fallback defaults; prefer fetching from /ws/config at runtime
VITE_OIDC_AUTHORITY=https://cognito-idp.ap-southeast-2.amazonaws.com/ap-southeast-2_OOXU9GW39
VITE_OIDC_CLIENT_ID=7a46r5h2l5ktfoim584osa8rlv
VITE_OIDC_SCOPE=openid profile email ala/attrs ala/roles

# ALA Common UI — static HTML fragments + CSS/JS (same pattern as doi-ui)
# For local dev with atlas-index static-server running on port 8082:
VITE_COMMON_HEADER_HTML=http://localhost:8082/static/common/header.html
VITE_COMMON_FOOTER_HTML=http://localhost:8082/static/common/footer.html
VITE_COMMON_CSS=http://localhost:8082/static/common/common.css
VITE_COMMON_JS=http://localhost:8082/static/common/common.js
# For ALA test environment (uncomment and use these instead):
# VITE_COMMON_HEADER_HTML=https://static.test.ala.org.au/common/header.html
# VITE_COMMON_FOOTER_HTML=https://static.test.ala.org.au/common/footer.html
# VITE_COMMON_CSS=https://static.test.ala.org.au/common/common.css
# VITE_COMMON_JS=https://static.test.ala.org.au/common/common.js

# Banner messages
VITE_BANNER_MESSAGES_URL=http://localhost:8082/static/common/status.json
VITE_BANNER_SCOPE=collectory
